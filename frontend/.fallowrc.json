{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "ignoreDependencies": ["autoprefixer", "@typescript/native"],
  "entry": ["src/main.tsx", "scripts/*.mjs"],
  "dynamicallyLoaded": [
    "src/pages/admin/LeaveRequestsPage.tsx",
    "src/pages/admin/OvertimeLogsPage.tsx",
    "src/pages/admin/StandbyLogsPage.tsx",
    "src/pages/calendar/CalendarPage.tsx",
    "src/pages/team/TLApprovalDashboard.tsx",
    "src/plugins/control_room/pages/ControlRoomDashboardPage.tsx",
    "src/plugins/control_room/pages/ControlRoomAccessPage.tsx",
    "src/plugins/control_room/components/crTestFixtures.ts"
  ],
  "overrides": [
    {
      "files": [
        "src/components/ui/dialog.tsx",
        "src/components/ui/select.tsx",
        "src/components/ui/card.tsx",
        "src/components/dashboard/widgetRegistry.ts"
      ],
      "rules": {
        "unused-exports": "off"
      }
    },
    {
      "files": ["src/services/pluginService.ts"],
      "rules": {
        "unused-types": "off"
      }
    },
    {
      "files": [
        "scripts/visual-route-manifest.mjs",
        "scripts/visual-capture-helpers.mjs",
        "scripts/visual-fingerprint.mjs",
        "scripts/designlang-sanitize.mjs",
        "scripts/visual-route-manifest.test.mjs",
        "scripts/visual-capture-helpers.test.mjs",
        "scripts/visual-fingerprint.test.mjs"
      ],
      "rules": {
        "unused-exports": "off",
        "unused-files": "off"
      }
    },
    // Pre-existing dead files, verified unreachable (0 references outside the
    // file itself) but owned outside this round's scope. Declared here rather
    // than deleted so new unreachable files still fail the gate.
    {
      "files": [
        "src/components/dashboard/ProgressRing.tsx",
        "src/components/ui/FieldLabel.tsx",
        "src/pages/settings/components/PushNotificationSection.tsx"
      ],
      "rules": {
        "unused-files": "off"
      }
    },
    // Pre-existing type exports with no consumers, kept in their owners' zones.
    {
      "files": [
        "src/components/ui/tableTypes.ts",
        "src/components/ui/DateRangePicker.tsx",
        "src/components/ui/OptionPills.tsx",
        "src/plugins/data_import/types/dataImport.ts"
      ],
      "rules": {
        "unused-types": "off"
      }
    }
  ],
  "ignoreExports": [
    {
      "file": "src/plugins/organigrama/generatedMeta.ts",
      "exports": ["*"]
    },
    {
      "file": "src/plugins/organigrama/pages/groupHelpers.ts",
      "exports": ["*"]
    },
    {
      "file": "src/plugins/organigrama/types.ts",
      "exports": ["*"]
    },
    {
      "file": "src/plugins/organigrama/components/builderEdgeHelpers.ts",
      "exports": ["markerEndFor", "builderEdgeType"]
    },
    {
      "file": "src/plugins/organigrama/components/BuilderEdge.tsx",
      "exports": ["ReportsToEdge", "ContainsEdge", "DottedLineEdge", "AssistantEdge", "AssociationEdge"]
    },
    {
      "file": "src/plugins/organigrama/hooks/useBuilderGraphOps.ts",
      "exports": ["makeNode"]
    },
    {
      "file": "src/plugins/organigrama/hooks/useOrganigramaQueries.ts",
      "exports": ["useOrganigramaSubtree"]
    },
    {
      "file": "src/hooks/useMutationHandlers.ts",
      "exports": ["createMutationHandlers"]
    },
    {
      "file": "src/components/offline/OfflineIndicator.tsx",
      "exports": ["InlineOfflineBadge"]
    },
    {
      "file": "src/plugins/control_room/utils/controlRoomFormatters.ts",
      "exports": ["statusBadgeClass", "statusColor", "formatPercent"]
    },
    {
      "file": "src/pages/admin/hooks/hoursLogsFilter.ts",
      "exports": ["calculateHoursStats", "filterHoursLogs"]
    },
    // Pre-existing value exports with no consumers, kept in their owners'
    // zones rather than deleted. New unused exports still fail the gate.
    { "file": "src/components/calendar/calendarStyles.ts", "exports": ["calendarRowDivider"] },
    { "file": "src/components/dashboard/RoleSwitcher.tsx", "exports": ["RoleSwitcher"] },
    { "file": "src/components/ui/tone.ts", "exports": ["TONES"] },
    { "file": "src/components/visualization/chart.tsx", "exports": ["useChart"] },
    { "file": "src/lib/date-format-utils.ts", "exports": ["getMonthEndISO"] },
    { "file": "src/lib/motion.ts", "exports": ["hoverScaleClass"] },
    { "file": "src/pages/hr/HRCalendarsPage.tsx", "exports": ["HRCalendarsPage"] }
  ]
}
