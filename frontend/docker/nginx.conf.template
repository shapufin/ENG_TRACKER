# http-context directive — must sit outside the server{} block. Keyed on
# $realip_remote_addr, not $remote_addr: real_ip_module (below, in the
# server block) REWRITES $remote_addr to the CF-Connecting-IP value once a
# request is trusted, so by the time geo ran on $remote_addr it would be
# testing the real client's public IP against this private CIDR — never
# matching, and $trusted_ingress would wrongly read 0 for every genuine
# cloudflared-forwarded request. $realip_remote_addr always keeps the
# original TCP peer address regardless of any real_ip rewrite, which is
# exactly what needs checking here: did this connection actually come from
# cloudflared. Lets X-Forwarded-Proto below be trusted with the same
# boundary CF-Connecting-IP already gets from set_real_ip_from, instead of
# being forwarded unconditionally from whatever the connecting client claims.
geo $realip_remote_addr $trusted_ingress {
    default 0;
    172.28.0.0/24 1;
}

# P1-3: admin login brute-force rate limit, keyed on $remote_addr — already
# the real_ip-resolved client IP by the time any request reaches a location
# block below (real_ip_module rewrites it for trusted cloudflared
# connections, same as every other $remote_addr use in this file).
limit_req_zone $binary_remote_addr zone=admin_login:10m rate=5r/m;

server {
    listen 8080;
    server_name _;

    # nginx defaults to 1 MB, which 413s every evidence/import/document upload.
    # Ceiling = the largest backend limit (site-backup restore, 500 MB); each
    # endpoint still enforces its own, smaller limit.
    client_max_body_size 512m;
    root /usr/share/nginx/html;
    index index.html;

    # Ingress: Cloudflare Tunnel today, Traefik planned later (see
    # docker-compose.yml's cloudflared service comment for the switch-over).
    #
    # `cloudflared` is the only thing that can reach this container (the
    # host's published port is bound to 127.0.0.1, see docker-compose.yml).
    # It runs on this same docker network (frontend_net, pinned to
    # 172.28.0.0/24) and forwards Cloudflare's CF-Connecting-IP header,
    # which Cloudflare's edge sets and a client cannot spoof past it.
    # real_ip_module rewrites $remote_addr from that header, but ONLY for
    # connections whose actual TCP peer is inside set_real_ip_from — a
    # request that somehow reached this port some other way keeps its real
    # peer IP and a forged CF-Connecting-IP is simply ignored. This keeps
    # every $remote_addr use below (the /api/ location's
    # X-Forwarded-For, access logs) correct without touching
    # NUM_PROXIES in settings_production.py — nginx presents exactly one
    # trustworthy hop to Django no matter what sits in front of nginx.
    #
    # Moving to Traefik: swap the header to X-Forwarded-For (Traefik doesn't
    # send CF-Connecting-IP) and set_real_ip_from to Traefik's container/
    # network instead of cloudflared's.
    set_real_ip_from 172.28.0.0/24;
    real_ip_header CF-Connecting-IP;
    real_ip_recursive off;

    # P2-9: Security headers are set in the location blocks below, NOT at
    # the server level. This prevents duplicate headers on /api/ and
    # /media/ responses, which are proxied to Django (Django's
    # SecurityMiddleware sets the same headers).

    # Gzip
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript image/svg+xml;
    gzip_min_length 256;

    # Cache hashed assets aggressively (Vite uses content hashes)
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        # P2-9: security headers for static assets
        add_header X-Frame-Options "DENY" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        try_files $uri =404;
    }

    # SPA fallback: serve index.html for client-side routes
    # P2-9: security headers here (not at server level) to avoid
    # duplicates on proxied /api/ responses where Django also sets them.
    location / {
        # index.html must always revalidate: it references hashed /assets/
        # filenames, so a stale cached index.html serves a stale bundle
        # even though the assets themselves are correctly immutable-cached.
        add_header Cache-Control "no-cache" always;
        # Security headers (P0-1 CSP, P2-6 referrer, P2-8 XSS, P2-9 no dupes)
        add_header X-Frame-Options "DENY" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-XSS-Protection "1; mode=block" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
        # CSP, enforcing (flipped from report-only 2026-09-27 after a clean
        # report-only period with no violations — see
        # .devin/plans/plan-production-security-2026-08-21.md P0-1).
        # Allows service worker ('self' covers /sw.js), Vite module preload
        # (inline script), web push endpoints, and data/blob images.
        # ${ONLYOFFICE_ORIGIN} is this template's one substituted variable
        # (via nginx's built-in docker-entrypoint envsubst-on-templates,
        # restricted to real container env vars — see Dockerfile comment):
        # the onboarding plugin's document editor loads a script from, and
        # opens an iframe to, the OnlyOffice Document Server origin, which
        # is a different origin than this frontend and so needs an explicit
        # allowlist entry in script-src/connect-src/frame-src. Empty when
        # ONLYOFFICE_ORIGIN is unset (feature disabled) — envsubst leaves an
        # empty token in the header value, which every browser's CSP parser
        # ignores.
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' ${ONLYOFFICE_ORIGIN}; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://fcm.googleapis.com https://push.services.mozilla.com https://updates.push.services.mozilla.com ${ONLYOFFICE_ORIGIN}; frame-src 'self' ${ONLYOFFICE_ORIGIN}; manifest-src 'self'; worker-src 'self'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'" always;
        try_files $uri $uri/ /index.html;
    }

    # Proxy API requests to backend
    location /api/ {
        proxy_pass http://backend:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # Overwrite (not append) X-Forwarded-For with the real client IP.
        # $proxy_add_x_forwarded_for appends to any client-supplied XFF,
        # allowing throttle bypass via unique spoofed XFF values (P1-9).
        # With $remote_addr, the only XFF entry is the real client IP —
        # and, per the real_ip block above, $remote_addr is ALREADY the
        # tunnel-resolved real client IP, not cloudflared's. That is
        # deliberate: it means adding Cloudflare Tunnel in front needed no
        # change here and no NUM_PROXIES bump in settings_production.py.
        # Do not switch this to $proxy_add_x_forwarded_for — with real_ip
        # already resolving the correct IP, that would just append it a
        # second time.
        proxy_set_header X-Forwarded-For $remote_addr;
        # NOT $scheme: this nginx never terminates TLS (no `ssl` listener
        # anywhere in this file — see README's "TLS/HTTPS — required"), so
        # $scheme is unconditionally "http" here regardless of what the
        # real client used. Forwarding $scheme would tell Django every
        # request is plain HTTP even over Cloudflare Tunnel or a TLS-
        # terminating proxy in front, breaking SECURE_SSL_REDIRECT /
        # SECURE_PROXY_SSL_HEADER and secure cookies. Cloudflare's edge (or
        # any TLS-terminating proxy in front, per the README) already sets
        # X-Forwarded-Proto correctly on every request it forwards — pass
        # that through unchanged instead of overwriting it.
        #
        # But only from a connection nginx actually trusts: $trusted_ingress
        # (geo block above, same 172.28.0.0/24 boundary as CF-Connecting-IP)
        # gates this the same way set_real_ip_from gates the IP header. Any
        # connection from outside that network — someone on the host hitting
        # the 127.0.0.1-bound port directly, bypassing cloudflared — falls
        # back to "http", the fail-closed default, instead of trusting
        # whatever scheme that connection claims.
        set $forwarded_proto "http";
        if ($trusted_ingress = 1) {
            set $forwarded_proto $http_x_forwarded_proto;
        }
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_read_timeout 120s;
        proxy_connect_timeout 10s;
    }

    # Proxy media files to backend (Django serves media in dev; in prod
    # a CDN or S3 is preferred, but this keeps the stack self-contained).
    # P0-3 step 4: defense-in-depth headers — even if the backend view
    # failed to set them, nginx forces download + nosniff so uploaded
    # files (including legacy .html evidence) can never render inline.
    location /media/ {
        proxy_pass http://backend:8000;
        proxy_set_header Host $host;
        # Same reasoning as /api/ above — media is also served by a Django
        # view, so it is equally subject to SECURE_SSL_REDIRECT. This block
        # was missing all three headers entirely (pre-existing gap, not
        # something the tunnel introduced): without X-Forwarded-Proto,
        # every media download behind a TLS-terminating proxy 301-redirects
        # instead of serving the file.
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        # Same trust gate as /api/ above — see its comment.
        set $forwarded_proto "http";
        if ($trusted_ingress = 1) {
            set $forwarded_proto $http_x_forwarded_proto;
        }
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Content-Disposition "attachment" always;
    }

    # P0-8: proxy Django's static files (admin CSS/JS, collectstatic output,
    # served by WhiteNoise on the backend — config/settings_production.py)
    # to the backend. Without this location, /static/admin/... falls
    # through to the SPA catch-all below and admin renders unstyled/broken
    # — WhiteNoise being configured on the backend only helps once a
    # request for /static/ actually reaches that process.
    location /static/ {
        proxy_pass http://backend:8000;
        proxy_set_header Host $host;
        # Same reasoning as /media/ above: static files pass through Django's
        # SecurityMiddleware (SECURE_SSL_REDIRECT) before WhiteNoise, so without
        # X-Forwarded-Proto every admin asset 301-redirects behind a
        # TLS-terminating proxy. Same trust gate as /api/.
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        set $forwarded_proto "http";
        if ($trusted_ingress = 1) {
            set $forwarded_proto $http_x_forwarded_proto;
        }
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }

    # Admin login brute-force protection (P1-3): Django admin uses
    # django.contrib.auth.views.LoginView, not a DRF view, so the DRF
    # ScopedRateThrottle ('auth': 20/min on CustomTokenObtainPairView) never
    # covers it — admin login was completely unthrottled. Rate-limited here
    # at the proxy layer instead of adding a new Python dependency
    # (django-axes/django-defender) or a UX change (django-otp 2FA), per
    # .devin/plans/plan-production-security-2026-08-21.md P1-3's options.
    # 5 requests/minute per IP, burst 3 (one extra retry without an
    # immediate 503) — generous enough for a real user mistyping a
    # password twice, tight enough to make brute-forcing impractical.
    location /admin/login/ {
        limit_req zone=admin_login burst=3 nodelay;
        limit_req_status 429;
        proxy_pass http://backend:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        set $forwarded_proto "http";
        if ($trusted_ingress = 1) {
            set $forwarded_proto $http_x_forwarded_proto;
        }
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }

    # Proxy the rest of Django admin (unthrottled here — only the login POST
    # is brute-forceable; everything else requires an authenticated session).
    location /admin/ {
        proxy_pass http://backend:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        set $forwarded_proto "http";
        if ($trusted_ingress = 1) {
            set $forwarded_proto $http_x_forwarded_proto;
        }
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }
}
