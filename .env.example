# Engineering Tracker — Docker Compose Environment
# Copy to .env and fill in real values before `docker compose up -d`

# Django
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-to-a-real-secret-key
ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_URL=http://localhost:8080
FRONTEND_PORT=8080

# Two-factor authentication (MFA / TOTP)
# Fernet key(s) that encrypt two-factor seeds, comma-separated (first encrypts, all decrypt).
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required in production. Keep with SECRET_KEY; losing it locks out enrolled users.
MFA_ENCRYPTION_KEYS=change-me-to-a-fernet-key
# Optional: display name shown in authenticator apps (defaults to 'Engineering Tracker')
# MFA_ISSUER=Engineering Tracker

#Superuser
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-me-to-a-strong-password
# PostgreSQL
DB_NAME=engtracker
DB_USER=engtracker
DB_PASSWORD=change-me-to-a-strong-password
# SSL mode for the DB connection: prefer (default, encrypts if available),
# require (force SSL), verify-full (force SSL + verify server cert, needs
# DB_SSL_ROOTCERT). Use require/verify-full for managed DBs (RDS/Cloud SQL).
DB_SSL_MODE=prefer

# Redis (required for production — docker-compose enforces it)
REDIS_PASSWORD=change-me-to-a-strong-redis-password

# Web Push (generate with: python -m py_vapid generate)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Email (optional — if not set, emails are skipped)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# Generated files (exports and year snapshots)
# Both live OUTSIDE MEDIA_ROOT, so Site Backup never zips them and /media/ can never
# serve them. Exports are transient (24 h, regenerable, NOT backed up); snapshots are
# durable year-close evidence and ARE archived by the db-backup loop.
# docker-compose mounts the volumes at /app/exports and /app/snapshots, which are the
# defaults — override only if you mount them somewhere else. Both must be writable by
# uid 10001 (the image's app user).
# EXPORT_ROOT=/app/exports
# SNAPSHOT_ROOT=/app/snapshots
# Dev/test only: build an export synchronously at request time. Keep it off in
# production so the scheduler builds it and gunicorn never streams a big file.
# EXPORT_JOBS_INLINE=True

# Cache invalidation version (increment on deploy to bust all cache)
#CACHE_VERSION=1
